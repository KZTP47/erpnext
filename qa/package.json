{
  "name": "erpnext-qa-work-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:domain": "node scripts/stack.mjs domain",
